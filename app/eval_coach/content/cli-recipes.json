{
  "recipes": [
    {
      "id": "copilot",
      "name": "GitHub Copilot CLI",
      "tool_name": "GitHub Copilot CLI",
      "cli_command": "copilot",
      "headless": {"args": ["-p", "{line}"], "timeout_seconds": 120},
      "shell": "cmd",
      "command": "winget install GitHub.Copilot",
      "needs_mb": 400,
      "plain": "Installs GitHub Copilot CLI, GitHub's AI tool, from GitHub. It takes about 400 MB of disk and needs a GitHub Copilot license.",
      "source": "GitHub's official Copilot CLI documentation",
      "requires": {"command": "pwsh", "name": "PowerShell 6 or later", "recipe": "powershell", "detail": "GitHub Copilot CLI needs PowerShell 6 or later. Windows only includes PowerShell 5.1, so install PowerShell first with the option below."},
      "platforms": {
        "windows": {"available": true},
        "mac": {"shell": "zsh", "command": "curl -fsSL https://gh.io/copilot-install | bash", "requires": null}
      },
      "models": {
        "discover": {"command": "/model", "ready_quiet_seconds": 3, "read_quiet_seconds": 2, "max_seconds": 45,
                     "stop_words": ["sign in", "log in", "trust", "allow", "approve"],
                     "id_pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"},
        "sonnet": {"label": "Sonnet", "keyword": "sonnet", "launch": ["--model={id}"], "fallback_id": "claude-sonnet-5.5"},
        "haiku": {"label": "Haiku", "keyword": "haiku", "launch": ["--model={id}"], "fallback_id": "claude-haiku-5.5"}
      }
    },
    {
      "id": "claude-installer",
      "name": "Claude Code (installer script)",
      "tool_name": "Claude Code",
      "cli_command": "claude",
      "headless": {"args": ["-p", "{line}"], "timeout_seconds": 120},
      "shell": "cmd",
      "command": "curl -fsSL https://claude.ai/install.cmd -o install.cmd && install.cmd && del install.cmd",
      "needs_mb": 400,
      "plain": "Installs Claude Code, Anthropic's AI tool, from Anthropic's own installer. It takes about 400 MB of disk and needs a Claude account that includes Claude Code.",
      "source": "Anthropic's official Claude Code documentation",
      "platforms": {
        "windows": {"available": true},
        "mac": {"shell": "zsh", "command": "curl -fsSL https://claude.ai/install.sh | bash"}
      },
      "models": {
        "sonnet": {"label": "Sonnet", "launch": ["--model", "sonnet"]},
        "haiku": {"label": "Haiku", "launch": ["--model", "haiku"]}
      }
    },
    {
      "id": "claude-winget",
